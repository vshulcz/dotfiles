# Appearance. Included from ./config

font-family = JetBrainsMono Nerd Font Mono
font-size = 14

# Follows the macOS light/dark setting
theme = light:Catppuccin Latte,dark:Catppuccin Mocha

window-padding-x = 8
window-padding-y = 8
cursor-style = block
cursor-style-blink = false

mouse-hide-while-typing = true
unfocused-split-opacity = 0.7

# Native fullscreen makes macOS spawn a Space, which drops the window out of
# AeroSpace's tiling. Non-native keeps it a normal window.
macos-non-native-fullscreen = true
macos-titlebar-style = tabs

# Looser line spacing — easier on long agent logs
adjust-cell-height = 10%

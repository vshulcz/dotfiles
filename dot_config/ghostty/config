# Ghostty config. Reload in-app: cmd+shift+,
# Full reference: ghostty +show-config --default --docs

config-file = appearance
config-file = keybinds

scrollback-limit = 25000
window-save-state = always
copy-on-select = clipboard
quick-terminal-position = top
quick-terminal-size = 40%
quick-terminal-autohide = true
auto-update = check

# cmd+w must not silently kill a long-running agent
confirm-close-surface = true

# Option = Meta, so alt+b / alt+d / alt+backspace work in zsh.
# Note: alt+f is swallowed by AeroSpace ('layout floating tiling').
macos-option-as-alt = true

# Finished agent in a background split gets a highlighted border, not just a dock bounce
bell-features = attention,title,border

# Carry ghostty terminfo to remote hosts so TUIs render right over ssh.
# Installs into ~/.terminfo on first login to each host. Cache: ghostty +ssh-cache
shell-integration-features = cursor,no-sudo,title,ssh-env,ssh-terminfo,path

# Long multi-line prompts get pasted into agents constantly; the confirm dialog
# is pure friction. Bracketed-paste safety stays on.
clipboard-paste-protection = false

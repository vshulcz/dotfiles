#!/bin/sh
# ci — clipboard image out to a file, and the path back into the clipboard.
# Ghostty ignores raw image data on paste, so hand it a path instead.
set -eu
dir="${TMPDIR:-/tmp}/clip-images"
mkdir -p "$dir"
file="$dir/clip-$(date +%Y%m%d-%H%M%S).png"

if ! pngpaste "$file" 2>/dev/null; then
    echo "no image in the clipboard" >&2
    exit 1
fi
printf '%s' "$file" | pbcopy
echo "$file"

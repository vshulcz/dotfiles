#!/usr/bin/env python3
"""ytm - pick a track, let YouTube's mix keep playing, watch it in the terminal.

  ytm <query>       search, pick one, play it and the mix that follows
  ytm -v <query>    show the clip instead of the cover (no status line:
                    mpv has to own the terminal to draw video)
  ytm -1 <query>    just that track, no mix
  ytm <url>         play a track, album or playlist as given
  ytm               resume whatever played last
"""
import base64, fcntl, json, math, os, re, select, shutil, signal, socket, struct
import subprocess, sys, termios, threading, time, tty

CACHE = os.path.expanduser(os.environ.get("XDG_CACHE_HOME", "~/.cache")) + "/ytm-last"
SOCK = f"/tmp/ytm-{os.getpid()}.sock"
RESULTS = int(os.environ.get("YTM_RESULTS", 25))
QUEUE = int(os.environ.get("YTM_QUEUE", 40))
LOOKAHEAD = int(os.environ.get("YTM_LOOKAHEAD", 4))
MEDIA_MAX = int(os.environ.get("YTM_MEDIA_COLS", 56))
LEFT = 3
ESC = "\033"

def out(s): sys.stdout.write(s); sys.stdout.flush()
def at(r, c): return f"{ESC}[{r};{c}H"
def eol(): return f"{ESC}[K"


def cell_px():
    try:
        buf = fcntl.ioctl(sys.stdout.fileno(), termios.TIOCGWINSZ, b"\0" * 8)
        rows, cols, xp, yp = struct.unpack("HHHH", buf)
        if cols and rows and xp and yp:
            return xp / cols, yp / rows          # float: integer division skewed the ratio
    except Exception:
        pass
    return 8.0, 16.0


def media_box():
    term = shutil.get_terminal_size((80, 24))
    cols = max(20, min(MEDIA_MAX, term.columns - 2 * LEFT))
    cw, ch = cell_px()
    rows = max(3, round((cols * cw * 9 / 16) / ch))
    return cols, rows


def ytdlp(args):
    p = subprocess.run(["yt-dlp", "--no-warnings"] + args, capture_output=True, text=True)
    return p.stdout.splitlines() if p.returncode == 0 else []


def search(query):
    lines = ytdlp(["--flat-playlist", "--print",
                   "%(id)s|%(channel)s — %(title)s [%(duration_string)s]",
                   f"ytsearch{RESULTS}:{query}"])
    lines = [l for l in lines if "|" in l]
    if not lines:
        sys.exit("nothing found")
    fz = subprocess.run(["fzf", "--with-nth=2..", "--delimiter=|", "--height=45%",
                         "--reverse", "--no-multi", f"--prompt=▶ {query} > "],
                        input="\n".join(lines), capture_output=True, text=True)
    if fz.returncode != 0 or not fz.stdout.strip():
        sys.exit(0)
    return fz.stdout.strip().split("|", 1)[0]


def build_queue(url):
    """Flat list of (id, title, channel) — resolved to real stream URLs later."""
    rows = ytdlp(["--flat-playlist", "--playlist-items", f"1-{QUEUE}",
                  "--print", "%(id)s\t%(title)s\t%(channel)s", url])
    q = []
    for r in rows:
        parts = r.split("\t")
        if len(parts) >= 2 and len(parts[0]) == 11:
            q.append((parts[0], parts[1], parts[2] if len(parts) > 2 else ""))
    return q


class Mpv:
    def __init__(self, video, box):
        # video: let mpv resolve each track itself. Youtube serves video as
        # fragmented DASH, and a bare stream URL hands us only the first
        # fragment — playback hit EOF after ~3s and skipped to the next track.
        # audio-only URLs are progressive, so those we can prefetch.
        cmd = ["mpv", "--idle=yes", "--no-terminal", "--really-quiet",
               "--ytdl=yes" if video else "--ytdl=no",
               "--gapless-audio=yes", f"--input-ipc-server={SOCK}"]
        if video:
            # mpv is the only thing allowed to write to the tty here: its kitty
            # frames and our own cursor writes would shred each other otherwise
            cmd += ["--vo=kitty", "--profile=sw-fast"]
        else:
            cmd += ["--no-video"]
        self.proc = subprocess.Popen(cmd)
        self.lock = threading.Lock()
        self.sock, self.buf, self.rid = None, b"", 0
        for _ in range(120):
            if os.path.exists(SOCK):
                try:
                    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
                    s.connect(SOCK); s.settimeout(0.4); self.sock = s; break
                except OSError:
                    pass
            time.sleep(0.1)
        if not self.sock:
            sys.exit("mpv did not start")

    def cmd_(self, *args):
        with self.lock:
            self.rid += 1
            rid = self.rid
            try:
                self.sock.send((json.dumps({"command": list(args), "request_id": rid}) + "\n").encode())
            except OSError:
                return None
            end = time.time() + 0.6
            while time.time() < end:
                try:
                    chunk = self.sock.recv(65536)
                except (socket.timeout, OSError):
                    return None
                if not chunk:
                    return None
                self.buf += chunk
                while b"\n" in self.buf:
                    line, self.buf = self.buf.split(b"\n", 1)
                    try:
                        msg = json.loads(line)
                    except ValueError:
                        continue
                    if msg.get("request_id") == rid:
                        return msg.get("data")
            return None

    def get(self, p): return self.cmd_("get_property", p)
    def alive(self): return self.proc.poll() is None

    def quit(self):
        self.cmd_("quit")
        try: self.proc.wait(timeout=3)
        except Exception: self.proc.kill()


class Resolver(threading.Thread):
    """Turns queue entries into direct stream URLs before mpv needs them,
    so switching tracks never waits on a yt-dlp process."""
    def __init__(self, mpv, queue, fmt):
        super().__init__(daemon=True)
        self.mpv, self.queue, self.fmt = mpv, queue, fmt
        self.done = 0
        self.stop = threading.Event()

    def run(self):
        while not self.stop.is_set() and self.done < len(self.queue):
            pos = self.mpv.get("playlist-pos") or 0
            if self.done > pos + LOOKAHEAD:
                time.sleep(0.5); continue
            vid, title, chan = self.queue[self.done]
            urls = [u for u in ytdlp(["-f", self.fmt, "-g",
                                      f"https://www.youtube.com/watch?v={vid}"])
                    if u.startswith("http")]
            self.done += 1
            if not urls:
                continue
            label = f"{chan} — {title}" if chan else title
            opts = {"force-media-title": label}
            if len(urls) > 1:          # youtube stopped serving muxed formats
                opts["audio-file"] = urls[1]
            self.mpv.cmd_("loadfile", urls[0], "append-play", -1, opts)


_thumbs = {}
def thumbnail(vid, cols, rows):
    cw, ch = cell_px()
    key = (vid, cols, rows)
    if key in _thumbs:
        return _thumbs[key]
    data = None
    for name in ("hqdefault.jpg", "mqdefault.jpg"):
        f = subprocess.run(["curl", "-fsSL", "--max-time", "6",
                            f"https://i.ytimg.com/vi/{vid}/{name}"], capture_output=True)
        if f.returncode != 0 or not f.stdout:
            continue
        c = subprocess.run(["magick", "-", "-resize", f"{int(cols*cw)}x{int(rows*ch)}^",
                            "-gravity", "center", "-extent", f"{int(cols*cw)}x{int(rows*ch)}",
                            "png:-"], input=f.stdout, capture_output=True)
        if c.returncode == 0 and c.stdout[:8] == b"\x89PNG\r\n\x1a\n":
            data = c.stdout
            break
    _thumbs[key] = data
    return data


def draw_cover(vid, box):
    cols, rows = box
    out(f"{ESC}_Ga=d,d=A{ESC}\\")
    data = thumbnail(vid, cols, rows)
    if not data:
        return
    payload = base64.standard_b64encode(data)
    out(at(2, LEFT))
    chunks = [payload[i:i + 4096] for i in range(0, len(payload), 4096)]
    for i, ch in enumerate(chunks):
        head = f"a=T,f=100,t=d,c={cols},r={rows}," if i == 0 else ""
        out(f"{ESC}_G{head}m={1 if i < len(chunks) - 1 else 0};{ch.decode()}{ESC}\\")


def fmt_t(t):
    if t is None: return "--:--"
    t = int(t); return f"{t // 60}:{t % 60:02d}"


def render(p, queue, top, width, resolved):
    def line(r, s): out(at(r, LEFT) + s + eol())
    idx = p.get("playlist-pos") or 0
    title = p.get("media-title") or "loading…"
    artist = ""
    if 0 <= idx < len(queue):
        artist = queue[idx][2]
    pos, dur = p.get("time-pos"), p.get("duration")

    line(top, f"{ESC}[1m{title[:width]}{ESC}[0m")
    line(top + 1, f"{ESC}[2m{artist[:width]}{ESC}[0m")

    barw = max(10, width - 30)
    frac = (pos / dur) if (pos and dur) else 0
    filled = int(barw * min(max(frac, 0), 1))
    bar = "━" * filled + "╸" + "─" * max(0, barw - filled - 1)
    head = "❚❚" if p.get("pause") else "▶ "
    line(top + 3, f"{head} {bar} {fmt_t(pos)}/{fmt_t(dur)}")
    line(top + 4, f"{ESC}[2mtrack {idx + 1}/{len(queue)}   vol {int(p.get('volume') or 0)}%"
                  f"   ready {resolved}{ESC}[0m")

    line(top + 6, f"{ESC}[2mnext{ESC}[0m")
    for i in range(3):
        j = idx + 1 + i
        line(top + 7 + i, f"  {queue[j][1][:width - 2]}" if j < len(queue) else "")
    line(top + 11, f"{ESC}[2mspace pause   n next   p prev   +/- volume   q quit{ESC}[0m")


def main():
    args = sys.argv[1:]
    single = video = False
    while args and args[0] in ("-1", "--single", "-v", "--video"):
        if args[0] in ("-1", "--single"): single = True
        else: video = True
        args = args[1:]

    if not args:
        if not os.path.exists(CACHE):
            sys.exit("nothing played yet — try: ytm <query>")
        url = open(CACHE).read().strip()
    elif args[0].startswith("http"):
        url = args[0]
    else:
        vid = search(" ".join(args))
        url = (f"https://www.youtube.com/watch?v={vid}" if single
               else f"https://www.youtube.com/watch?v={vid}&list=RD{vid}")
    os.makedirs(os.path.dirname(CACHE), exist_ok=True)
    open(CACHE, "w").write(url)

    sys.stderr.write("building queue…\n")
    queue = build_queue(url)
    if not queue:
        sys.exit("could not read that playlist")

    box = media_box()
    top = 2 + box[1] + 1
    m = Mpv(video, box)
    if video:
        m.cmd_("loadfile", url, "replace", -1, {
            "ytdl-raw-options-append": f"playlist-items=1-{QUEUE}",
            "ytdl-format": "bestvideo[height<=480]+bestaudio/best",
        })
        m.cmd_("set_property", "ytdl-raw-options", "yes-playlist=")
        res = None
    else:
        res = Resolver(m, queue, "bestaudio/best")
        res.start()

    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    last_vid = None
    try:
        tty.setcbreak(fd)
        if not video:
            out(f"{ESC}[?25l{ESC}[2J")
        while m.alive():
            if not video:
                width = max(20, shutil.get_terminal_size((80, 24)).columns - 2 * LEFT)
                props = {k: m.get(k) for k in
                         ("media-title", "time-pos", "duration", "playlist-pos", "pause", "volume")}
                idx = props.get("playlist-pos") or 0
                if 0 <= idx < len(queue) and queue[idx][0] != last_vid:
                    last_vid = queue[idx][0]
                    draw_cover(last_vid, box)
                render(props, queue, top, width, res.done if res else 0)

            if select.select([sys.stdin], [], [], 0.4)[0]:
                k = sys.stdin.read(1)
                if k == "q": break
                elif k == " ": m.cmd_("cycle", "pause")
                elif k in ("n", ">"): m.cmd_("playlist-next", "force")
                elif k in ("p", "<"): m.cmd_("playlist-prev", "force")
                elif k in ("+", "="):
                    m.cmd_("set_property", "volume", min(100, int(m.get("volume") or 0) + 5))
                elif k == "-":
                    m.cmd_("set_property", "volume", max(0, int(m.get("volume") or 0) - 5))
    finally:
        if res: res.stop.set()
        termios.tcsetattr(fd, termios.TCSADRAIN, old)
        out(f"{ESC}_Ga=d,d=A{ESC}\\{ESC}[?25h{ESC}[2J{ESC}[H")
        m.quit()
        try: os.unlink(SOCK)
        except OSError: pass


if __name__ == "__main__":
    signal.signal(signal.SIGINT, lambda *_: sys.exit(0))
    main()

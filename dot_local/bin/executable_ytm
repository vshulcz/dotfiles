#!/usr/bin/env python3
"""ytm - pick a track, let YouTube's mix keep playing, watch it in the terminal.

  ytm <query>       search, pick one, play it and the mix that follows
  ytm -1 <query>    just that track, no mix
  ytm -v <query>    show the clip itself instead of the cover
  ytm <url>         play a track, album or playlist as given
  ytm               resume whatever played last
"""
import base64, fcntl, json, math, os, re, select, shutil, signal, socket, struct
import subprocess, sys, termios, time, tty

CACHE = os.path.expanduser(os.environ.get("XDG_CACHE_HOME", "~/.cache")) + "/ytm-last"
SOCK = f"/tmp/ytm-{os.getpid()}.sock"
RESULTS = int(os.environ.get("YTM_RESULTS", 25))
QUEUE = int(os.environ.get("YTM_QUEUE", 40))
MEDIA_MAX = int(os.environ.get("YTM_MEDIA_COLS", 56))
LEFT = 3

ESC = "\033"
def out(s): sys.stdout.write(s); sys.stdout.flush()
def at(r, c): return f"{ESC}[{r};{c}H"
def eol(): return f"{ESC}[K"


def cell_px():
    try:
        buf = fcntl.ioctl(sys.stdout.fileno(), termios.TIOCGWINSZ, b"\0" * 8)
        rows, cols, xp, yp = struct.unpack("HHHH", buf)
        if cols and rows and xp and yp:
            return xp // cols, yp // rows
    except Exception:
        pass
    return 8, 16


def media_box():
    """Cells for a 16:9 area at the top: (cols, rows)."""
    term = shutil.get_terminal_size((80, 24))
    cols = max(20, min(MEDIA_MAX, term.columns - 2 * LEFT))
    cw, ch = cell_px()
    rows = max(3, math.ceil((cols * cw * 9 / 16) / ch))
    return cols, rows


def search(query):
    fmt = "%(id)s|%(channel)s — %(title)s [%(duration_string)s]"
    p = subprocess.run(["yt-dlp", "--flat-playlist", "--no-warnings", "--print", fmt,
                        f"ytsearch{RESULTS}:{query}"], capture_output=True, text=True)
    lines = [l for l in p.stdout.splitlines() if "|" in l]
    if not lines:
        sys.exit("nothing found")
    fz = subprocess.run(["fzf", "--with-nth=2..", "--delimiter=|", "--height=45%",
                         "--reverse", "--no-multi", f"--prompt=▶ {query} > "],
                        input="\n".join(lines), capture_output=True, text=True)
    if fz.returncode != 0 or not fz.stdout.strip():
        sys.exit(0)
    return fz.stdout.strip().split("|", 1)[0]


class Mpv:
    def __init__(self, url, video, box):
        cmd = ["mpv", "--idle=once", "--no-terminal", "--really-quiet",
               f"--ytdl-raw-options-append=playlist-items=1-{QUEUE}",
               "--ytdl-raw-options-append=yes-playlist=",
               f"--input-ipc-server={SOCK}"]
        if video:
            cols, rows = box
            cmd += ["--vo=kitty", "--profile=sw-fast",
                    "--vo-kitty-alt-screen=no", "--vo-kitty-config-clear=no",
                    f"--vo-kitty-left={LEFT}", "--vo-kitty-top=2",
                    f"--vo-kitty-cols={cols}", f"--vo-kitty-rows={rows}"]
        else:
            cmd += ["--no-video", "--ytdl-format=bestaudio/best"]
        cmd.append(url)
        self.proc = subprocess.Popen(cmd)
        self.sock = None
        for _ in range(120):
            if os.path.exists(SOCK):
                try:
                    self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
                    self.sock.connect(SOCK); self.sock.settimeout(0.4); break
                except OSError:
                    self.sock = None
            time.sleep(0.1)
        if not self.sock:
            sys.exit("mpv did not start")
        self.buf, self.rid = b"", 0

    def cmd_(self, *args):
        self.rid += 1
        try:
            self.sock.send((json.dumps({"command": list(args), "request_id": self.rid}) + "\n").encode())
        except OSError:
            return None
        deadline = time.time() + 0.6
        while time.time() < deadline:
            try:
                chunk = self.sock.recv(65536)
            except (socket.timeout, OSError):
                return None
            if not chunk:
                return None
            self.buf += chunk
            while b"\n" in self.buf:
                line, self.buf = self.buf.split(b"\n", 1)
                try:
                    msg = json.loads(line)
                except ValueError:
                    continue
                if msg.get("request_id") == self.rid:
                    return msg.get("data")
        return None

    def get(self, p): return self.cmd_("get_property", p)
    def alive(self): return self.proc.poll() is None

    def quit(self):
        self.cmd_("quit")
        try: self.proc.wait(timeout=3)
        except Exception: self.proc.kill()


_thumbs = {}
def thumbnail(vid, cols, rows):
    cw, ch = cell_px()
    key = (vid, cols, rows)
    if key in _thumbs:
        return _thumbs[key]
    data = None
    for name in ("hqdefault.jpg", "mqdefault.jpg"):
        # curl, not urllib: system python has no CA bundle wired up here
        f = subprocess.run(["curl", "-fsSL", "--max-time", "6",
                            f"https://i.ytimg.com/vi/{vid}/{name}"], capture_output=True)
        if f.returncode != 0 or not f.stdout:
            continue
        # png because the kitty graphics protocol (f=100) takes nothing else
        c = subprocess.run(["magick", "-", "-resize", f"{cols*cw}x{rows*ch}", "png:-"],
                           input=f.stdout, capture_output=True)
        if c.returncode == 0 and c.stdout[:8] == b"\x89PNG\r\n\x1a\n":
            data = c.stdout
            break
    _thumbs[key] = data
    return data


def draw_cover(vid, box):
    cols, rows = box
    out(f"{ESC}_Ga=d,d=A{ESC}\\")
    data = thumbnail(vid, cols, rows)
    if not data:
        return
    payload = base64.standard_b64encode(data)
    out(at(2, LEFT))
    chunks = [payload[i:i + 4096] for i in range(0, len(payload), 4096)]
    for i, ch in enumerate(chunks):
        head = f"a=T,f=100,t=d,c={cols},r={rows}," if i == 0 else ""
        out(f"{ESC}_G{head}m={1 if i < len(chunks) - 1 else 0};{ch.decode()}{ESC}\\")


def fmt(t):
    if t is None: return "--:--"
    t = int(t); return f"{t // 60}:{t % 60:02d}"


def vid_of(path):
    if not path: return None
    m = re.search(r"[?&]v=([\w-]{11})", path) or re.search(r"/([\w-]{11})$", path)
    return m.group(1) if m else None


def render(p, state, top, width):
    def line(row, s): out(at(row, LEFT) + s + eol())

    title = p.get("media-title") or "loading…"
    meta = p.get("metadata") or {}
    artist = meta.get("uploader") or meta.get("artist") or ""
    pos, dur = p.get("time-pos"), p.get("duration")
    idx, total = p.get("playlist-pos"), p.get("playlist-count")

    line(top, f"{ESC}[1m{title[:width]}{ESC}[0m")
    line(top + 1, f"{ESC}[2m{artist[:width]}{ESC}[0m")

    barw = max(10, width - 30)
    frac = (pos / dur) if (pos and dur) else 0
    filled = int(barw * min(max(frac, 0), 1))
    bar = "━" * filled + "╸" + "─" * max(0, barw - filled - 1)
    head = "❚❚" if p.get("pause") else "▶ "
    line(top + 3, f"{head} {bar} {fmt(pos)}/{fmt(dur)}")
    line(top + 4, f"{ESC}[2mtrack {(idx or 0) + 1}/{total or '?'}   vol {int(p.get('volume') or 0)}%{ESC}[0m")

    line(top + 6, f"{ESC}[2mnext{ESC}[0m")
    up = state.get("upcoming", [])
    for i in range(3):
        line(top + 7 + i, f"  {up[i][:width - 2]}" if i < len(up) else "")
    line(top + 11, f"{ESC}[2mspace pause   n next   p prev   +/- volume   q quit{ESC}[0m")


def main():
    args = sys.argv[1:]
    single = video = False
    while args and args[0] in ("-1", "--single", "-v", "--video"):
        if args[0] in ("-1", "--single"): single = True
        else: video = True
        args = args[1:]

    if not args:
        if not os.path.exists(CACHE):
            sys.exit("nothing played yet — try: ytm <query>")
        url = open(CACHE).read().strip()
    elif args[0].startswith("http"):
        url = args[0]
    else:
        vid = search(" ".join(args))
        url = (f"https://www.youtube.com/watch?v={vid}" if single
               else f"https://www.youtube.com/watch?v={vid}&list=RD{vid}")
    os.makedirs(os.path.dirname(CACHE), exist_ok=True)
    open(CACHE, "w").write(url)

    box = media_box()
    top = 2 + box[1] + 1
    m = Mpv(url, video, box)
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    state, last_vid, tick = {"upcoming": []}, None, 0
    try:
        tty.setcbreak(fd)
        out(f"{ESC}[?25l{ESC}[2J")
        while m.alive():
            width = max(20, shutil.get_terminal_size((80, 24)).columns - 2 * LEFT)
            props = {k: m.get(k) for k in
                     ("media-title", "metadata", "time-pos", "duration",
                      "playlist-pos", "playlist-count", "pause", "volume", "path")}
            v = vid_of(props.get("path"))
            if v and v != last_vid:
                last_vid = v
                if not video:
                    draw_cover(v, box)
            tick += 1
            if tick % 4 == 1:
                pl = m.get("playlist") or []
                cur = props.get("playlist-pos") or 0
                state["upcoming"] = [e.get("title") or e.get("filename", "") for e in pl[cur + 1:cur + 4]]
            render(props, state, top, width)

            if select.select([sys.stdin], [], [], 0.5)[0]:
                k = sys.stdin.read(1)
                if k == "q": break
                elif k == " ": m.cmd_("cycle", "pause")
                elif k in ("n", ">"): m.cmd_("playlist-next", "force")
                elif k in ("p", "<"): m.cmd_("playlist-prev", "force")
                elif k in ("+", "="): m.cmd_("add", "volume", 5)
                elif k == "-": m.cmd_("add", "volume", -5)
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)
        out(f"{ESC}_Ga=d,d=A{ESC}\\{ESC}[?25h{ESC}[2J{ESC}[H")
        m.quit()
        try: os.unlink(SOCK)
        except OSError: pass


if __name__ == "__main__":
    signal.signal(signal.SIGINT, lambda *_: sys.exit(0))
    main()

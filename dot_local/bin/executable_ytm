#!/usr/bin/env bash
# ytm — pick a track, then let YouTube's own mix keep the music going.
#   ytm bonobo kerala     search, pick one, play it and its radio mix
#   ytm -1 bonobo kerala  just that track, no mix
#   ytm <url>             play a track, album or playlist as given
#   ytm                   resume whatever played last
set -euo pipefail

LAST="${XDG_CACHE_HOME:-$HOME/.cache}/ytm-last"
COUNT="${YTM_RESULTS:-25}"     # search results to choose from
QUEUE="${YTM_QUEUE:-40}"       # how much of the mix to queue up front
mkdir -p "$(dirname "$LAST")"

single=0
if [ "${1-}" = "-1" ] || [ "${1-}" = "--single" ]; then single=1; shift; fi

play() {
  printf '\033]0;ytm\007'
  echo "  space pause   > next   < prev   9/0 volume   q quit"
  mpv --no-video --ytdl-format='bestaudio/best' \
      --ytdl-raw-options-append=playlist-items="1-${QUEUE}" \
      --term-osd-bar --msg-level=all=error,statusline=status \
      --term-playing-msg='  ♪ ${media-title}' \
      --input-ipc-server="${TMPDIR:-/tmp}/ytm.sock" \
      "$@"
}

if [ $# -eq 0 ]; then
  [ -s "$LAST" ] || { echo "nothing played yet — try: ytm <query>"; exit 1; }
  play "$(cat "$LAST")"
  exit $?
fi

if [[ "$1" == http*://* ]]; then
  printf '%s' "$1" > "$LAST"
  play "$1"
  exit $?
fi

pick=$(
  yt-dlp --flat-playlist --no-warnings \
         --print '%(id)s|%(channel)s — %(title)s [%(duration_string)s]' \
         "ytsearch${COUNT}:$*" 2>/dev/null \
    | fzf --with-nth='2..' --delimiter='|' --height=45% --reverse \
          --prompt="▶ $* > " --no-multi
) || exit 0

id=${pick%%|*}
if [ "$single" = 1 ]; then
  url="https://www.youtube.com/watch?v=${id}"
else
  # RD<id> is YouTube's own mix seeded from that track — endless related music
  url="https://www.youtube.com/watch?v=${id}&list=RD${id}"
fi
printf '%s' "$url" > "$LAST"
play "$url"
